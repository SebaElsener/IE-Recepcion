
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IE Reparaciones</title>
    <link rel="stylesheet" href="/css/form.css">
    <link rel="stylesheet" href="/css/flip-card.css">
    <script src="/script/dselect.min.js"></script>
    <link rel="stylesheet" href="/css/dselect.css">
    <script src="/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <script src="/script/toastify-js-master/src/toastify.js"></script>
    <link rel="stylesheet" href="/script/toastify-js-master/src/toastify.css">
</head>
<body>
    <main>
        <div id="title">
            <h4 class="title">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
                    <label class="form-check-label" for="flexSwitchCheckDefault" id="flexSwitchCheckDefaultLabel">Registro clientes</label>
                </div>
            </h4>
        </div>
        <div id="formContainer">
            <div class="flip-container">
                <div id="flip-card" class="flip-card">
                    <div class="front">
                        <form id="clientForm">
                            <div class="form-group presupuestoFechaContainer">
                                <label class="formLabel presupuestoLabel" for="presupuesto">Presupuesto Nro: 
                                    <input class="formInput" type="number" name="id" id="presupuesto" readonly value='<%= orderId %>'>
                                </label>
                                <label class="formLabel fechaLabel" for="fechaRecepcion">Fecha recepción: 
                                    <input class="formInput" id="fechaRecepcion" class="disabledInput" name="fechaRecepcion" readonly type="text">
                                </label>
                            </div>
                            <div class="form-group nombreApellidoContainer">
                                <label class="formLabel nombreLabel" for="nombre">
                                    <input class="formInput" type="text" name="nombre" id="nombre" required placeholder="Nombre">
                                </label>
                                <label class="formLabel nombreLabel" for="apellido">
                                    <input class="formInput" type="text" name="apellido" id="apellido" required placeholder="Apellido">
                                </label>
                                <label class="formLabel dniLabel" for="dni">
                                    <input class="formInput" type="number" name="dni" id="dni" required placeholder="DNI">
                                </label>
                            </div>
                            <div class="form-group device-brand-model">
                                <label class="formLabel" for="dispositivo">
                                    <select class="selectSearch" name="dispositivo" id="dispositivo" required>
                                        <option value="">Dispositivo</option>
                                        <% devices.forEach(function(device) { %>
                                            <option value='<%= device.device %>'>
                                                <%= device.device %>
                                            </option>
                                        <% }) %>
                                    </select>
                                </label>
                                <label class="formLabel brand" for="marca">
                                    <select class="selectSearch" name="marca" id="marca" required>
                                        <option value="">Marca</option>
                                        <% brands.forEach(function(brand) { %>
                                            <option value='<%= brand.brand %>'>
                                                <%= brand.brand %>
                                            </option>
                                        <% }) %>
                                    </select>
                                </label>
                                <label class="formLabel model" for="modelo">
                                    <select class="selectSearch" name="modelo" id="modelo" required>
                                        <option value="">Modelo</option>
                                        <% models.forEach(function(model) { %>
                                            <option value='<%= model.model %>'>
                                                <%= model.model %>
                                            </option>
                                        <% }) %>
                                    </select>
                                </label>
                            </div>
                            <div class="form-group">
                                <label class="formLabel problema" for="problema">
                                    <textarea class="form-control" rows="4" name="problema" id="problema" placeholder="Detalle problema" required></textarea>
                                </label>
                            </div>
                            <div class="form-group fechasContainer">
                                <label class="formLabel fechaDiagnosticoLabel" for="fechaDiagnostico">Fecha estimada diagnóstico: 
                                    <input class="formInput" type="date" name="fechaDiagnostico" id="fechaDiagnostico" required>
                                </label>
                                <label class="formLabel fechaReparacionLabel" for="fechaReparacion">Fecha estimada reparación: 
                                    <input class="formInput" type="date" name="fechaReparacion" id="fechaReparacion" required>
                                </label>
                            </div>
                            <div class="form-group">
                                <label class="formLabel contacto" for="contacto">
                                    <input class="formInput contacto inputUnderLine" type="text" name="contacto" id="contacto" required placeholder="Contacto">
                                </label>
                            </div>
                            <button id="sendBtn" class="sendBtn btn btn-outline-primary btn-block" type="submit" formmethod="post" formaction="/">Registrar</button>
                        </form>
                    </div>
                    <div class="back">
                        <form id="clientForm-back">
                            <div class="form-group presupuestoFechaContainer">
                                <label id="presupuestoLabelBack" class="formLabel presupuestoLabel" for="presupuesto">Presupuesto Nro: 
                                    <input class="formInput" type="number" name="id" id="presupuesto-back" autocomplete="off" placeholder="Consultar por presupuesto">
                                </label>
                                <label class="formLabel fechaLabel" for="fechaRecepcion">Fecha recepción: 
                                    <input class="formInput" id="fechaRecepcion-back" class="disabledInput" name="fechaRecepcion" readonly type="text">
                                </label>
                            </div>
                            <div class="form-group nombreApellidoContainer">
                                <label id="nombreLabelBack" class="formLabel nombreLabel" for="nombreApellido">
                                    <input class="formInput" type="text" name="nombreApellido" id="nombreApellido-back" autocomplete="off" placeholder="Consultar por nombre o apellido">
                                </label>
                                <label class="formLabel dniLabel" for="dni" id="dniLabel-back">
                                    <input class="formInput" type="number" name="dni" id="dni-back" autocomplete="off" placeholder="Consultar por DNI">
                                </label>
                            </div>
                            <div class="form-group device-brand-model">
                                <label class="formLabel" for="dispositivo-back">
                                    <input class="selectSearch" name="dispositivo-back" id="dispositivo-back" readonly>
                                </label>
                                <label class="formLabel brand" for="marca-back">
                                    <input class="selectSearch" name="marca-back" id="marca-back" readonly>
                                </label>
                                <label class="formLabel model" for="modelo-back">
                                    <input class="selectSearch" name="modelo-back" id="modelo-back" readonly>
                                </label>
                            </div>
                            <div class="form-group">
                                <label class="formLabel problema" for="problema">
                                    <textarea class="form-control" rows="4" name="problema" id="problema-back" readonly></textarea>
                                </label>
                            </div>
                            <div id="fechasContainerBack" class="form-group fechasContainer">
                                <label class="formLabel fechaDiagnosticoLabel" for="fechaDiagnostico">Fecha estimada diagnóstico: 
                                    <input class="formInput" type="date" name="fechaDiagnostico" id="fechaDiagnostico-back" readonly>
                                </label>
                                <label class="formLabel fechaReparacionLabel" for="fechaReparacion">Fecha estimada reparación: 
                                    <input class="formInput" type="date" name="fechaReparacion" id="fechaReparacion-back" readonly>
                                </label>
                            </div>
                            <div class="form-group">
                                <label class="formLabel contacto" for="contacto">
                                    <input class="formInput contacto inputUnderLine" type="text" name="contacto" id="contacto-back" readonly>
                                </label>
                            </div>
                            <div id="signContainer" class="form-group signContainer">
                                <div id="signImage">
                                    <canvas id="canvas" style="cursor:crosshair;"></canvas>
                                </div>
                                <div id="signOptionsContainer">
                                    <div id="clearSignContainer">
                                    </div>
                                    <div id="signRegContainer">
                                    </div>
                                </div>
                            </div>
                            <div id="sendBtnContainer">
                                <div id="goBackPage">
                                    <p class="pageLink"><<</p>
                                </div>
                                <div id="sendBtn-back-container">
                                    <button id="sendBtn-back" class="sendBtn btn btn-outline-primary btn-block" type="submit" formmethod="post" formaction="/consultas">
                                        Consultar
                                    </button>
                                </div>
                                <div id="goFwdPage">
                                    <p class="pageLink">>></p>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script src="/script/form.js"></script>
    <script src="/script/consultas.js"></script>
    <script src="/script/FormInteract.js"></script>

</body>
</html>